    judgeRow: (name, score) => `${name} — ${score} ${pointNoun(score)}`,
    judgePunished: (name) => `⚖️ ${name} punished!`, judgeResult: (amt, loss, name) => `+${amt} to you · -${loss} to ${name}`,
    contArrow: (t) => t ? `Continue → (${t})` : 'Continue →',
    winChip: (medal, name, score) => `${medal} ${name}: ${score}`,
    pitToast: '⏩ Pit stop — points at the end!', fwdToast: '🟢 Boost forward!', backToast: '🔴 Slide back!',
    pitDone: (n) => `🏁 Pit stop done +${n}!`,
    switchToRacer: '↔ 🏎️ Racer', switchToJudge: '↔ ⚖️ Judge',
    cardInHand: 'Card in hand — plays on “Start turn”',
    judgeNoVictims: 'No one to steal points from — opponents at 0',
  },
};

function t(key, ...args) {
  const tbl = I18N[currentLang] || I18N.ru;
  let v = tbl[key];
  if (v === undefined) v = I18N.ru[key];
  if (v === undefined) return key;
  return typeof v === 'function' ? v(...args) : v;
}

function applyStaticI18n() {
  document.querySelectorAll('[data-i18n]').forEach(el => {
    el.textContent = t(el.getAttribute('data-i18n'));
  });
  document.querySelectorAll('[data-i18n-ph]').forEach(el => {
    el.setAttribute('placeholder', t(el.getAttribute('data-i18n-ph')));
  });
}

function updateLangButton() {
  const b = document.getElementById('btn-lang');
  if (b) b.textContent = currentLang === 'ru' ? 'EN' : 'RU';
}

function setLang(lang) {
  if (lang !== 'ru' && lang !== 'en') return;
  currentLang = lang;
  try { localStorage.setItem('vr_lang', lang); } catch (e) {}
  parseDict(lang); // ленивый парсинг словаря выбранного языка
  if (DICTS[lang] && DICTS[lang].length) dictionary = DICTS[lang];
  applyStaticI18n();
  updateLangButton();
}

function toggleLang(e) {
  if (e) e.stopPropagation();
  setLang(currentLang === 'ru' ? 'en' : 'ru');
}

// ═══════════════════════════════════════════
// ОНЛАЙН (Supabase Realtime — Broadcast + Presence)
// Синхронизируем только очки и индекс хода.
// Канал vr-room-<КОД>, без таблиц/RLS.
// ═══════════════════════════════════════════
const SUPA_URL = 'https://cxhpcmgtvuhxhqhjryth.supabase.co';
const SUPA_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImN4aHBjbWd0dnVoeGhxaGpyeXRoIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODA0ODMyNDMsImV4cCI6MjA5NjA1OTI0M30.o_nSHWRHJb1SU8JBE7p_154hLPwpt7yYo9uPdkArr-E';

let sb = null;
let lobbyChannel = null;
let myUid = null;
const online = { active: false, host: false, code: null, channel: null, myIdx: 0, started: false, matching: false, matchSent: false };

function ensureClient() {
  if (sb) return sb;
  if (!window.supabase || !window.supabase.createClient) return null;
  sb = window.supabase.createClient(SUPA_URL, SUPA_KEY, { realtime: { params: { eventsPerSecond: 10 } } });
  return sb;
}

function genCode() {
  const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789'; // без похожих 0/O/1/I
  let c = '';
  for (let i = 0; i < 4; i++) c += chars[Math.floor(Math.random() * chars.length)];
  return c;
}

function openOnline() {
  document.getElementById('online-choice').style.display = 'flex';
  document.getElementById('online-wait').style.display = 'none';
  document.getElementById('online-error').textContent = '';
  document.getElementById('online-code-input').value = '';
  showScreen('screen-online');
}

function onlineError(msg) { document.getElementById('online-error').textContent = msg; }

function createRoom() {
  if (!ensureClient()) return onlineError(t('noConnection'));
  online.host = true; online.myIdx = 0;
  connectRoom(genCode());
}

function joinRoom() {
  const code = document.getElementById('online-code-input').value.trim().toUpperCase();
  if (code.length !== 4) return onlineError(t('enterCode'));
  if (!ensureClient()) return onlineError(t('noConnection'));
  online.host = false; online.myIdx = 1;
  connectRoom(code);
}

// ── Случайная игра (подбор через общий лобби-канал) ──
function quickMatch() {
  if (!ensureClient()) return onlineError(t('noConnection'));
  myUid = Math.random().toString(36).slice(2, 10);
  online.active = true; online.matching = true; online.matchSent = false;
  document.getElementById('online-choice').style.display = 'none';
  document.getElementById('online-wait').style.display = 'flex';
  document.getElementById('online-room-code').textContent = '🔍';
  document.getElementById('online-status').textContent = t('searching');

  const lobby = sb.channel('vr-lobby', {
    config: { presence: { key: myUid }, broadcast: { self: true } }
  });
  lobbyChannel = lobby;

  lobby.on('broadcast', { event: 'match' }, ({ payload }) => {
    if (!online.matching) return;
    if (payload.host === myUid || payload.guest === myUid) {
      const iAmHost = payload.host === myUid;
      online.matching = false;
      cleanupLobby();
      online.host = iAmHost; online.myIdx = iAmHost ? 0 : 1;
      connectRoom(payload.code);
    }
  });

  lobby.on('presence', { event: 'sync' }, () => {
    if (!online.matching || online.matchSent) return;
    const state = lobby.presenceState();
    const list = Object.keys(state)
      .map(k => ({ uid: k, ts: (state[k][0] && state[k][0].ts) || 0 }))
      .sort((a, b) => a.ts - b.ts || (a.uid < b.uid ? -1 : 1));
    if (list.length >= 2 && list[0].uid === myUid) {
      online.matchSent = true;
      lobby.send({ type: 'broadcast', event: 'match',
        payload: { host: list[0].uid, guest: list[1].uid, code: genCode() } });
    }
  });

  lobby.subscribe(status => {
    if (status === 'SUBSCRIBED') lobby.track({ ts: Date.now() });
    else if (status === 'CHANNEL_ERROR' || status === 'TIMED_OUT') onlineBackToChoice(t('connError'));
  });
}

function cleanupLobby() {
  if (lobbyChannel) { try { sb.removeChannel(lobbyChannel); } catch (e) {} lobbyChannel = null; }
}

function connectRoom(code) {
  online.active = true; online.code = code; online.started = false;
  document.getElementById('online-choice').style.display = 'none';
  document.getElementById('online-wait').style.display = 'flex';
  document.getElementById('online-room-code').textContent = code;
  document.getElementById('online-status').textContent = online.host ? t('waitingOpponent') : t('connecting');

  const channel = sb.channel('vr-room-' + code, {
    config: { broadcast: { self: false }, presence: { key: online.host ? 'host' : 'guest' } }
  });
  online.channel = channel;

  channel.on('broadcast', { event: 'msg' }, ({ payload }) => handleNetMsg(payload));

  channel.on('presence', { event: 'sync' }, () => {
    const state = channel.presenceState();
    const keys = Object.keys(state);
    const both = keys.includes('host') && keys.includes('guest');
    if (both) updateOppStatus(true);
    if (both && online.host && !online.started) {
      online.started = true;
      netSend({ t: 'start' });
      beginOnline();
    }
  });

  channel.on('presence', { event: 'leave' }, () => {
    updateOppStatus(false);
    if (online.started && !gameOver) opponentLeft();
  });

  channel.subscribe(status => {
    if (status === 'SUBSCRIBED') {
      channel.track({ role: online.host ? 'host' : 'guest', at: Date.now() });
      if (!online.host) document.getElementById('online-status').textContent = t('waitingHost');
    } else if (status === 'CHANNEL_ERROR' || status === 'TIMED_OUT') {
      onlineBackToChoice(t('connError'));
    }
  });
}

function onlineBackToChoice(msg) {
  if (online.channel) { try { sb.removeChannel(online.channel); } catch (e) {} online.channel = null; }
  cleanupLobby();
  online.active = false; online.started = false; online.matching = false; online.matchSent = false;
  document.getElementById('online-wait').style.display = 'none';
  document.getElementById('online-choice').style.display = 'flex';
  onlineError(msg || '');
}

function netSend(payload) {
  if (online.channel) online.channel.send({ type: 'broadcast', event: 'msg', payload });
}

function beginOnline() {
  const blue  = { ...PLAYERS_CONFIG[0], isBot: false };
  const green = { ...PLAYERS_CONFIG[1], isBot: false };
  startGame(2, [blue, green]);          // сбросит gameOver, currentPlayerIdx=0, колоду, фишки
  updateOnlineTurnUI();
  updateOppStatus(true);
}

function isMyTurn() {
  return online.active ? (currentPlayerIdx === online.myIdx) : true;
}

function serializeHands() {
  return players.map(p => (p.specialCards || []).map(c => c.type));
}

function applyHands(hands) {
  if (!hands) return;
  hands.forEach((arr, i) => {
    if (!players[i]) return;
    players[i].specialCards = arr.map(type => ({ ...SPECIAL_DEF[type] })).filter(c => c.type);
  });
  renderScoreboard();
  renderSpecialCards();
}

function updateOnlineTurnUI() {
  const btn = document.getElementById('btn-play-turn');
  if (!online.active) { btn.textContent = t('startTurn'); return; }
  if (isMyTurn()) {
    btn.disabled = false;
    btn.textContent = t('startTurn');
  } else {
    btn.disabled = true;
    btn.textContent = t('oppTurn');
  }
}

function updateOppStatus(isOnline) {
  const el = document.getElementById('opp-status');
  if (!el) return;
  if (!online.active) { el.textContent = ''; el.className = ''; return; }
  el.textContent = isOnline ? t('oppOnline') : t('oppOffline');
  el.className = isOnline ? 'opp-on' : 'opp-off';
}

function handleNetMsg(m) {
  if (!online.active) return;
  switch (m.t) {
    case 'start':
      if (!online.host && !online.started) { online.started = true; beginOnline(); }
      break;
    case 'result':
      // Пассивный игрок: показать результат хода соперника (только чтение)
      showOpponentResult(m.success, m.title, m.sub);
      break;
    case 'sync':
      applySync(m.scores, m.cur, m.hands);
      break;
    case 'win':
      applyWin(m.scores);
      break;
    case 'hands':
      applyHands(m.hands);
      break;
    case 'usecard':
      applyHands(m.hands);
      showToast(t('oppUsed', SPECIAL_DEF[m.card] ? SPECIAL_DEF[m.card].icon : '🃏', m.card === 'racer' ? t('racerName') : t('judgeName')), 2600);
      SFX.card();
      break;
    case 'dice':
      rollDice(m.v); // показать кубик с тем же значением
      break;
    case 'spect':
      applySpect(m); // живой просмотр задания соперника
      break;
  }
}

function showOpponentResult(success, title, sub) {
  if (success) SFX.success(); else SFX.fail();
  const emoji = document.getElementById('result-emoji');
  emoji.textContent = success ? '✅' : '❌';
  emoji.style.animation = 'none'; void emoji.offsetHeight; emoji.style.animation = '';
  document.getElementById('result-text').textContent = title || t('opponent');
  document.getElementById('result-sub').textContent = sub || '';
  document.getElementById('btn-continue').style.display = 'none'; // пассивный не жмёт
  showScreen('screen-result');
}

// Активный игрок транслирует состояние своего задания, пассивный смотрит вживую
function broadcastSpect() {
  if (!(online.active && online.started && isMyTurn())) return;
  netSend({
    t: 'spect',
    card: currentCard,
    needed: wordsNeeded,
    typed: taskTyped.map(t => t.ch).join(''),
    used: taskCurrentLetters.map(l => l.used),
    found: taskWordsFound.slice(),
    time: taskTimeLeft
  });
}

function applySpect(m) {
  document.getElementById('task-source-word').textContent = (m.card || '').toUpperCase();
  const c = document.getElementById('task-letters');
  c.innerHTML = '';
  (m.card || '').split('').forEach((ch, idx) => {
    const btn = document.createElement('button');
    btn.className = 'letter-btn' + (m.used && m.used[idx] ? ' used' : '');
    btn.textContent = ch.toUpperCase();
    btn.disabled = true;
    c.appendChild(btn);
  });
  document.getElementById('task-word-display').textContent = m.typed ? m.typed.toUpperCase() : '_ _ _';
  document.getElementById('task-counter').textContent = `${t('opponent')}: ${(m.found || []).length}/${m.needed}`;
  const timerEl = document.getElementById('task-timer');
  timerEl.textContent = `${m.time}⏰`;
  timerEl.className = (m.time <= 10 ? 'panic' : '');
  const uw = document.getElementById('task-used-words');
  uw.innerHTML = '';
  (m.found || []).forEach(w => { const t = document.createElement('span'); t.className = 'used-word-tag'; t.textContent = w; uw.appendChild(t); });
  document.getElementById('task-actions').style.display = 'none';
  document.getElementById('task-error').textContent = t('watching');
  if (activeScreen !== 'screen-task') showScreen('screen-task');
}

function applySync(scores, cur, hands) {
  showScreen('screen-game');
  players.forEach((p, i) => {
    const delta = scores[i] - p.score;
    if (delta !== 0) moveToken(p, Math.abs(delta), delta > 0 ? 1 : -1);
  });
  currentPlayerIdx = cur;
  if (hands) hands.forEach((arr, i) => { if (players[i]) players[i].specialCards = arr.map(t => ({ ...SPECIAL_DEF[t] })).filter(c => c.type); });
  renderScoreboard(); updateTurnLabel(); renderSpecialCards();
  updateOnlineTurnUI();
}

function applyWin(scores) {
  showScreen('screen-game');
  players.forEach((p, i) => {
    const delta = scores[i] - p.score;
    if (delta !== 0) moveToken(p, Math.abs(delta), delta > 0 ? 1 : -1);
  });
  setTimeout(() => checkWin(), 700);
}

function opponentLeft() {
  gameOver = true;
  document.getElementById('dc-text').textContent = t('dcText');
  document.getElementById('dc-sub').textContent = t('dcSub');
  document.getElementById('overlay-disconnect').classList.add('show');
  SFX.win();
}

function leaveOnline() {
  if (online.channel) { try { sb.removeChannel(online.channel); } catch (e) {} }
  cleanupLobby();
  online.active = false; online.host = false; online.started = false; online.channel = null; online.code = null;
  online.matching = false; online.matchSent = false;
  document.getElementById('overlay-disconnect').classList.remove('show');
  showScreen('screen-menu');
  updateContinueButton();
}

// ═══════════════════════════════════════════
// ПАУЗА-МЕНЮ
// ═══════════════════════════════════════════
function openPause() {
  const box = document.getElementById('pause-buttons');
  box.innerHTML = '';
  const mk = (cls, label, fn) => {
    const b = document.createElement('button');
    b.className = 'pause-btn ' + cls; b.textContent = label; b.onclick = fn;
    box.appendChild(b);
  };
  mk('resume', '▶️ Продолжить', closePause);
  if (online.active) {
    mk('exit', '🚪 Выйти из онлайн-игры', () => { closePause(); leaveOnline(); });
  } else {
    mk('end', '🏁 Закончить партию', () => { closePause(); endMatch(); });
    mk('exit', '🚪 Выход в меню', () => { closePause(); exitToMenu(); });
  }
  document.getElementById('overlay-pause').classList.add('show');
}
function closePause() { document.getElementById('overlay-pause').classList.remove('show'); }

// Выход в меню — партия сохраняется (доступна «Продолжить»)
function exitToMenu() {
  saveGame();
  showScreen('screen-menu');
  updateContinueButton();
}

// Закончить партию — стереть сохранение, показать итоговую таблицу
function endMatch() {
  clearSave();
  gameOver = true;
  stopTimer();
  const sorted = [...players].sort((a, b) => b.score - a.score);
  const leader = sorted[0];
  const nameEl = document.getElementById('win-winner-name');
  nameEl.textContent = leader.name; nameEl.style.color = leader.color;
  document.getElementById('win-winner-label').textContent = t('leadingOver');
  document.getElementById('win-stats').innerHTML = sorted.map((p, i) =>
    `<div class="win-stat-chip" style="border:2px solid ${p.color}44;color:${p.color}">${['🥇','🥈','🥉','4️⃣'][i]} ${p.name}: ${p.score}</div>`
  ).join('');
  showScreen('screen-win');
}

// ═══════════════════════════════════════════
// 3D КУБИК
// ═══════════════════════════════════════════
// Как повернуть куб, чтобы нужная грань смотрела на камеру:
// front=1, back=6, right=2, left=5, top=3, bottom=4
const DICE_SHOW = {
  1: { x:   0, y:   0 },  // front
  2: { x:   0, y: -90 },  // right
  3: { x: -90, y:   0 },  // top
  4: { x:  90, y:   0 },  // bottom
  5: { x:   0, y:  90 },  // left
  6: { x:   0, y: 180 },  // back
};

// Текущие углы куба (накапливаем, чтобы не сбрасывать)
let cubeRotX = -25;
let cubeRotY =  35;

function rollDice(forced) {
  return new Promise(resolve => {
    const overlay  = document.getElementById('overlay-dice');
    const cube     = document.getElementById('dice-cube');
    const resultEl = document.getElementById('dice-result-text');
    const result   = forced || (Math.floor(Math.random() * 6) + 1);

    resultEl.className  = '';
    resultEl.textContent = '';
    overlay.classList.add('show');
    SFX.dice();

    // Добавляем 2 полных оборота (720°) + финальный угол для нужной грани
    const targetX = cubeRotX + 720 + DICE_SHOW[result].x - (cubeRotX % 360);
    const targetY = cubeRotY + 720 + DICE_SHOW[result].y - (cubeRotY % 360);

    // Небольшой старт без transition (начальный толчок)
    cube.style.transition = 'none';
    cube.style.transform  = `rotateX(${cubeRotX}deg) rotateY(${cubeRotY}deg)`;

    requestAnimationFrame(() => requestAnimationFrame(() => {
      cube.style.transition = 'transform 1.3s cubic-bezier(0.17,0.67,0.16,1.0)';
      cube.style.transform  = `rotateX(${targetX}deg) rotateY(${targetY}deg)`;
      cubeRotX = targetX;
      cubeRotY = targetY;

      setTimeout(() => {
        cube.classList.add('landing');
        setTimeout(() => cube.classList.remove('landing'), 400);

        resultEl.textContent = t('diceMake', result);
        resultEl.className = 'show';

        setTimeout(() => {
          overlay.classList.remove('show');
          resolve(result);
        }, 1500);
      }, 1300);
    }));
  });
}

// ═══════════════════════════════════════════
// ЗАГРУЗКА
// ═══════════════════════════════════════════

// Swift вызовет эту функцию после загрузки страницы
let menuShown = false;
const DICT_RAW = { ru: null, en: null };

// Парсит сырой текст словаря в массив (тяжёлая операция — делаем лениво)
function parseDict(lang) {
  if (DICTS[lang] && DICTS[lang].length) return;
  const text = DICT_RAW[lang];
  if (!text) return;
  const re = lang === 'en' ? /^[a-z]+$/ : /^[а-яё]+$/;
  DICTS[lang] = text.split('\n')
    .map(w => w.trim().toLowerCase())
    .filter(w => w.length >= 2 && w.length <= 21 && re.test(w));
}

// Принять сырой словарь (вызывают Swift и fetch). Парсим только текущий язык —
// второй язык распарсится лениво при переключении (чтобы не блокировать старт).
window.__injectDict = function(lang, text) {
  if (DICT_RAW[lang]) { if (lang === currentLang && dictionary.length) onDictReady(); return; }
  DICT_RAW[lang] = text;
  if (lang === currentLang) {
    parseDict(lang);
    dictionary = DICTS[lang];
    onDictReady();
  }
};
// Совместимость со старым вызовом (русский)
window.__injectDictionary = function(text) { window.__injectDict('ru', text); };

function onDictReady() {
  if (menuShown) return;
  menuShown = true;
  updateLoadingBar(90);
  updateLoadingStatus(`${t('dictLoaded')}: ${dictionary.length}`);
  setTimeout(async () => {
    updateLoadingBar(100);
    await sleep(300);
    showScreen('screen-menu');
  }, 600);
}

async function init() {
  applyStaticI18n();
  // В релизе прячем debug-панель (🐞)
  if (!DEBUG_ENABLED) {
    const dt = document.getElementById('debug-toggle');
    const dp = document.getElementById('debug-panel');
    if (dt) dt.style.display = 'none';
    if (dp) dp.style.display = 'none';
  }
  document.querySelectorAll('.sound-toggle').forEach(b => b.textContent = SFX.isOn() ? '🔊' : '🔇');
  updateLangButton();
  updateLoadingBar(20);
  updateLoadingStatus(t('loading'));
  // В приложении словари присылает Swift (быстрее и без дублей). fetch —
  // запасной путь для браузера: пробуем, только если Swift не успел за 900мс.
  setTimeout(async () => {
    if (DICT_RAW[currentLang]) return; // Swift уже прислал
    try {
      const [ru, en] = await Promise.all([
        fetch('dictionary.txt').then(r => r.ok ? r.text() : null).catch(() => null),
        fetch('dictionary_en.txt').then(r => r.ok ? r.text() : null).catch(() => null),
      ]);
      if (ru) window.__injectDict('ru', ru);
      if (en) window.__injectDict('en', en);
    } catch (e) {}
  }, 900);
  setTimeout(() => {
    if (!dictionary.length) updateLoadingStatus(t('dictFail'));
  }, 10000);
}
function updateLoadingBar(p) { document.getElementById('loading-bar').style.width = p + '%'; }
function updateLoadingStatus(t) { document.getElementById('loading-status').textContent = t; }

// ═══════════════════════════════════════════
// НАСТРОЙКА — ВЫБОР ИГРОКОВ И БОТОВ
// ═══════════════════════════════════════════
const setupSlots = PLAYERS_CONFIG.map((cfg, i) => ({
  ...cfg, included: i < 2, isBot: false, botDifficulty: 'normal'
}));

function renderSetup() {
  const container = document.getElementById('setup-slots');
  if (!container) return;
  container.innerHTML = '';
  setupSlots.forEach((slot, i) => {
    const row = document.createElement('div');
    const isFixed = i === 0;
    row.className = 'setup-slot' + (isFixed ? ' fixed' : '') + (!slot.included ? ' inactive' : '');
    if (!isFixed) row.onclick = e => { if (!e.target.classList.contains('bot-toggle')) toggleInclude(i); };

    const colorDot = `<div class="setup-color" style="background:${slot.color}"></div>`;
    const name     = `<div class="setup-name" style="color:${slot.color}">${colorName(i)}</div>`;
    let control;
    if (isFixed) {
      control = `<div class="setup-badge you">${t('you')}</div>`;
    } else if (!slot.included) {
      control = `<div class="setup-badge add">${t('addPlayer')}</div>`;
    } else {
      const diffLabel = `${BOT_EMOJI[slot.botDifficulty]} ${botLevelName(slot.botDifficulty)}`;
      control = `<button class="bot-toggle${slot.isBot ? ' is-bot' : ''}" onclick="toggleBot(${i})">${slot.isBot ? t('bot') : t('human')}</button>${slot.isBot ? `<button class="diff-toggle${slot.botDifficulty === 'hard' ? ' hard' : ''}" onclick="toggleDiff(${i})">${diffLabel}</button>` : ''}`;
    }
    row.innerHTML = colorDot + name + control;
    container.appendChild(row);
  });
}

function toggleInclude(i) {
  const count = setupSlots.filter(s => s.included).length;
  if (setupSlots[i].included && count <= 2) return;
  setupSlots[i].included = !setupSlots[i].included;
  renderSetup();
}

function toggleBot(i) {
  setupSlots[i].isBot = !setupSlots[i].isBot;
  renderSetup();
}

function toggleDiff(i) {
  const idx = BOT_LEVELS.indexOf(setupSlots[i].botDifficulty);
  setupSlots[i].botDifficulty = BOT_LEVELS[(idx + 1) % BOT_LEVELS.length];
  renderSetup();
}

function startGameFromSetup() {
  clearSave();
  const active = setupSlots.filter(s => s.included);
  startGame(active.length, active);
}

// ═══════════════════════════════════════════
// НАЧАЛО ИГРЫ
// ═══════════════════════════════════════════
function startGame(n, slots) {
  const source = slots || PLAYERS_CONFIG.slice(0, n);
  players = source.map(cfg => ({ ...cfg, name: colorName(cfg.id), score: 0, pit: null, specialCards: [] }));
  gameOver = false;
  currentPlayerIdx = 0;
  turnsUntilSpecial = rollSpecialGap();
  buildDeck();
  renderScoreboard();
  updateTurnLabel();
  updateOnlineTurnUI();
  updateOppStatus();
  showScreen('screen-game');  // showScreen сам вызовет drawBoard для screen-game
}

// Отрисовать поле: ждём, пока картинка получит реальный размер (экран виден),
// затем синхронизируем слои, создаём фишки и рисуем клетки. Без этого при первом
// показе getBoundingClientRect = 0 и поле остаётся пустым до первого хода.
function drawBoard(tries = 0) {
  const img = document.getElementById('field-img');
  const ir  = img ? imageContentRect(img) : { width: 0 };
  if (ir.width <= 0) {
    if (tries < 40) requestAnimationFrame(() => drawBoard(tries + 1));
    return;
  }
  syncLayers();
  // Создаём фишки, только если их ещё нет; иначе просто переставляем (без сброса анимации).
  const haveTokens = players.length && document.getElementById('token-' + players[0].id);
  if (!haveTokens) renderTokens();
  else players.forEach(p => positionToken(p, true));
  renderCells();
}

// Случайный интервал (в ходах) до следующей спецкарты: 5..10.
function rollSpecialGap() { return 5 + Math.floor(Math.random() * 6); }

function buildDeck() {
  const cardWords = dictionary.filter(w => w.length >= 7);
  const shuffled = [...cardWords].sort(() => Math.random() - 0.5);
  // Колода — только слова-карточки. Спецкарты выдаются по счётчику ходов (см. startTurn).
  deck = shuffled.slice(0, Math.min(shuffled.length, 200));
}

function drawCard() {
  if (deck.length === 0) buildDeck();
  const card = deck.shift();
  if (typeof card === 'string' && card === currentCard) { deck.push(card); return drawCard(); }
  return card;
}

// Можно ли собрать слово w из букв карточки (по мультимножеству букв)
function canMakeFrom(w, counts) {
  const need = {};
  for (const ch of w) {
    need[ch] = (need[ch] || 0) + 1;
    if (need[ch] > (counts[ch] || 0)) return false;
  }
  return true;
}

// Сколько РЕАЛЬНЫХ слов из словаря можно составить из карточки (ранний выход на limit).
// exclude — необязательный Set слов, которые пропустить (напр. уже найденные игроком).
function findSubWords(card, limit, exclude) {
  const counts = {};
  for (const ch of card) counts[ch] = (counts[ch] || 0) + 1;
  const out = [];
  for (let i = 0; i < dictionary.length; i++) {
    const w = dictionary[i];
    if (w.length < 2 || w.length > card.length || w === card) continue;
    if (exclude && exclude.has(w)) continue;
    if (canMakeFrom(w, counts)) {
      out.push(w);
      if (out.length >= limit) break;
    }
  }
  return out;
}

// ═══════════════════════════════════════════
// ХОД
// ═══════════════════════════════════════════
async function startTurn(pref = null) {
  if (gameOver) return;
  preferredCard = pref;
  document.getElementById('btn-play-turn').disabled = true;

  // Спецкарта раз в 5–10 ходов — выдаётся текущему игроку.
  let gotSpecial = false;
  if (--turnsUntilSpecial <= 0) {
    const type = Math.random() < 0.5 ? 'racer' : 'judge';
    const sp = { ...SPECIAL_DEF[type] };
    currentPlayer().specialCards.push(sp);
    renderSpecialCards();
    renderScoreboard();
    showToast(t('gotCard', sp.icon + ' ' + (type === 'racer' ? t('racerName') : t('judgeName'))));
    gotSpecial = true;
    turnsUntilSpecial = rollSpecialGap();
  }

  wordsNeeded = await rollDice();
  if (online.active && online.started && isMyTurn()) netSend({ t: 'dice', v: wordsNeeded });

  // Слово-карточка: из неё должно складываться ≥ wordsNeeded слов.
  let card = drawCard();
  let tries = 0;
  while (tries < 60 && findSubWords(card, wordsNeeded).length < wordsNeeded) {
    tries++;
    card = drawCard();
  }
  currentCard = card;
  if (gotSpecial && online.active && isMyTurn()) netSend({ t: 'hands', hands: serializeHands() });

  if (currentPlayer().isBot) {
    botPlayTurn();
    return;
  }
  const cards = currentPlayer().specialCards;
  if (cards.length > 0) {
    const chosen = (preferredCard && cards.includes(preferredCard))
      ? preferredCard
      : cards[cards.length - 1];
    showSpecialOverlay(chosen);
  } else {
    goToBlindScreen();
  }
  preferredCard = null;
}

function showSpecialOverlay(card) {
  currentSpecialCard = card;
  const isRacer = card.type === 'racer';
  const popup = document.getElementById('special-popup');
  popup.className = 'special-popup ' + (isRacer ? 'racer-popup' : 'judge-popup');
  popup.style.animation = 'none';
  void popup.offsetHeight;
  popup.style.animation = '';

  document.getElementById('special-popup-icon').textContent  = card.icon;
  document.getElementById('special-card-title').textContent  = isRacer ? t('racerCardTitle') : t('judgeCardTitle');
  document.getElementById('special-card-desc').textContent   = isRacer
    ? t('racerDesc', wordsNeeded)
    : t('judgeCardDesc', wordsNeeded);

  const useBtn = document.getElementById('btn-use-special');
  useBtn.className = isRacer ? 'racer' : 'judge';
  useBtn.textContent = isRacer ? t('useRacer') : t('useJudge');

  // Судью нельзя использовать, если не у кого отбирать очки (все соперники на 0).
  const player = currentPlayer();
  const noVictims = !isRacer && !players.some(p => p.id !== player.id && p.score > 0);
  useBtn.disabled = noVictims;
  useBtn.style.opacity = noVictims ? '0.4' : '';
  useBtn.style.cursor  = noVictims ? 'default' : '';
  if (noVictims) {
    document.getElementById('special-card-desc').textContent = t('judgeNoVictims');
  }

  // Если в руке несколько РАЗНЫХ карт — даём выбрать другую.
  const cards = currentPlayer().specialCards;
  const hasOther = cards.some(c => c.type !== card.type);
  const switchBtn = document.getElementById('btn-switch-special');
  switchBtn.style.display = hasOther ? '' : 'none';
  switchBtn.textContent = (card.type === 'racer' ? t('switchToJudge') : t('switchToRacer'));

  document.getElementById('overlay-special').classList.add('show');
  SFX.card();
}

// Переключить оверлей на другую карту в руке (Гонщик ↔ Судья).
function switchSpecialCard() {
  const cards = currentPlayer().specialCards;
  const other = cards.find(c => c.type !== currentSpecialCard.type);
  if (other) showSpecialOverlay(other);
}

function hideSpecialOverlay() {
  document.getElementById('overlay-special').classList.remove('show');
  currentSpecialCard = null;
  goToBlindScreen();
}

function useSpecialCard() {
  document.getElementById('overlay-special').classList.remove('show');
  const player = currentPlayer();
  const usedType = currentSpecialCard ? currentSpecialCard.type : null;
  player.specialCards = player.specialCards.filter(c => c !== currentSpecialCard);
  renderSpecialCards();
  renderScoreboard();
  if (online.active && isMyTurn() && usedType) {
    netSend({ t: 'usecard', who: currentPlayerIdx, card: usedType, name: player.name });
  }

  if (currentSpecialCard.type === 'racer') {
    showResult(true, t('racerGo'), t('racerFwd', wordsNeeded), async () => {
      showScreen('screen-game');
      await sleep(80);
      await moveToken(player, wordsNeeded, 1);
      spawnScoreFloat(player.id, `+${wordsNeeded}`, player.color);
      if (checkWin()) return;
      afterMove();
    });
  } else {
    showJudgeScreen();
  }
  currentSpecialCard = null;
}

function showJudgeScreen() {
  const player = currentPlayer();
  const container = document.getElementById('judge-targets');
  container.innerHTML = '';
  players.forEach((p, idx) => {
    if (p.id === player.id) return;
    const btn = document.createElement('button');
    btn.className = 'judge-target-btn';
    btn.style.animationDelay = (idx * 0.07) + 's';
    btn.innerHTML = `<span style="width:14px;height:14px;border-radius:50%;background:${p.color};display:inline-block;flex-shrink:0"></span>${t('judgeRow', p.name, p.score)}`;
    btn.onclick = () => applyJudge(p);
    container.appendChild(btn);
  });
  showScreen('screen-judge');
}

function applyJudge(victim) {
  const amount = wordsNeeded;
  const player = currentPlayer();
  const isBot = player.isBot;
  // Судья отбирает у жертвы ровно столько, сколько у неё есть (не больше amount),
  // и даёт игроку РОВНО ту же сумму (сколько отнял).
  const actualLoss = Math.min(victim.score, amount);
  victim.score = Math.max(0, victim.score - actualLoss);

  showResult(true, t('judgePunished', victim.name), t('judgeResult', actualLoss, actualLoss, victim.name), async () => {
    showScreen('screen-game');
    await sleep(80);
    if (actualLoss > 0) {
      await moveToken(player, actualLoss, 1, false);  // без срабатывания спецклеток
      spawnScoreFloat(player.id, `+${actualLoss}`, player.color);
      await moveToken(victim, actualLoss, -1);
      spawnScoreFloat(victim.id, `-${actualLoss}`, '#ff5252');
    }
    renderScoreboard();
    if (checkWin()) return;
    afterMove();
  });
  if (isBot) setTimeout(() => triggerContinue(), 1800);
}

function goToBlindScreen() {
  const p = currentPlayer();
  document.getElementById('blind-text').innerHTML =
    t('getReady', p.name, p.color);
  showScreen('screen-blind');
}

function beginTask() {
  setupTask();
  showScreen('screen-task');
  startTimer();
  broadcastSpect();
}

// ═══════════════════════════════════════════
// ЗАДАНИЕ
// ═══════════════════════════════════════════
function setupTask() {
  taskFinished = false;
  taskWordsFound = [];
  taskCurrentLetters = currentCard.split('').map((ch, i) => ({ ch, i, used: false }));
  taskTyped = [];
  document.getElementById('task-source-word').textContent = currentCard.toUpperCase();
  renderLetters(); renderTyped(); renderUsedWords();
  document.getElementById('task-error').textContent = '';
  document.getElementById('task-counter').textContent = `${t('words')}: 0/${wordsNeeded}`;
  document.getElementById('task-word-display').className = '';
  document.getElementById('task-timer').className = '';
  document.getElementById('task-actions').style.display = ''; // вернуть кнопки (могли быть скрыты в режиме наблюдателя)
}

function renderLetters() {
  const c = document.getElementById('task-letters');
  c.innerHTML = '';
  taskCurrentLetters.forEach((item, idx) => {
    const btn = document.createElement('button');
    btn.className = 'letter-btn' + (item.used ? ' used' : '');
    btn.textContent = item.ch.toUpperCase();
    btn.onclick = () => typeLetter(idx);
    c.appendChild(btn);
  });
}

function typeLetter(idx) {
  const item = taskCurrentLetters[idx];
  if (item.used) return;
  item.used = true;
  taskTyped.push({ ch: item.ch, srcIdx: idx });
  renderLetters(); renderTyped();
  broadcastSpect();
}

function renderTyped() {
  const d = document.getElementById('task-word-display');
  d.textContent = taskTyped.length > 0 ? taskTyped.map(t => t.ch.toUpperCase()).join('') : '_ _ _';
}

function clearWord() {
  taskTyped.forEach(t => { taskCurrentLetters[t.srcIdx].used = false; });
  taskTyped = [];
  renderLetters(); renderTyped();
  const d = document.getElementById('task-word-display');
  d.className = '';
  document.getElementById('task-error').textContent = '';
  broadcastSpect();
}

function submitWord() {
  const word = taskTyped.map(t => t.ch).join('').toLowerCase();
  const d = document.getElementById('task-word-display');

  if (word.length < 2)                   return animError(d, t('errMin2'));
  if (word === currentCard.toLowerCase()) return animError(d, t('errOriginal'));
  if (taskWordsFound.includes(word))      return animError(d, t('errDup'));
  if (!dictionary.includes(word))        return animError(d, t('errNotInDict'));

  taskWordsFound.push(word);
  SFX.word();
  d.className = 'flash-ok';
  setTimeout(() => { if (d.className === 'flash-ok') d.className = ''; }, 600);
  clearWord();
  renderUsedWords();
  document.getElementById('task-counter').textContent = `${t('words')}: ${taskWordsFound.length}/${wordsNeeded}`;

  if (taskWordsFound.length >= wordsNeeded) finishTask(true);
}

function animError(el, msg) {
  SFX.error();
  el.className = 'shake-err';
  setTimeout(() => { el.className = ''; }, 450);
  document.getElementById('task-error').textContent = msg;
  setTimeout(() => { document.getElementById('task-error').textContent = ''; }, 1800);
}

function renderUsedWords() {
  const c = document.getElementById('task-used-words');
  c.innerHTML = '';
  taskWordsFound.forEach(w => {
    const t = document.createElement('span');
    t.className = 'used-word-tag';
    t.textContent = w;
    c.appendChild(t);
  });
}

// ═══════════════════════════════════════════
// ТАЙМЕР
// ═══════════════════════════════════════════
function startTimer() {
  taskTimeLeft = TASK_TIME;
  updateTimerDisplay();
  taskTimerInterval = setInterval(() => {
    taskTimeLeft--;
    updateTimerDisplay();
    broadcastSpect();
    if (taskTimeLeft <= 0) finishTask(false);
  }, 1000);
}
function stopTimer() { clearInterval(taskTimerInterval); taskTimerInterval = null; }
function updateTimerDisplay() {
  const el = document.getElementById('task-timer');
  el.textContent = `${taskTimeLeft}⏰`;
  if (taskTimeLeft <= 10) el.classList.add('panic');
  else el.classList.remove('panic');
}

// ═══════════════════════════════════════════
// ЗАВЕРШЕНИЕ
// ═══════════════════════════════════════════
let taskFinished = false;
function finishTask(success) {
  if (taskFinished) return;
  taskFinished = true;
  stopTimer();
  const player = currentPlayer();

  if (success) {
    showResult(true, t('great', player.name), t('fwd', wordsNeeded), async () => {
      showScreen('screen-game');
      await sleep(80);
      await moveToken(player, wordsNeeded, 1);
      spawnScoreFloat(player.id, `+${wordsNeeded}`, player.color);
      if (checkWin()) return;
      afterMove();
    });
  } else {
    // Подсказка-«можно было собрать»: исключаем слова, которые игрок уже нашёл.
    const hints = findSubWords(currentCard, 3, new Set(taskWordsFound));
    const hintSub = hints.length > 0
      ? t('could', hints.slice(0, 3).join(', '))
      : t('backN', wordsNeeded);
    showResult(false, t('timeUp', wordsNeeded), hintSub, async () => {
      showScreen('screen-game');
      await sleep(80);
      await moveToken(player, wordsNeeded, -1);
      spawnScoreFloat(player.id, `-${wordsNeeded}`, '#ff5252');
      afterMove();
    });
  }
}

// ═══════════════════════════════════════════
// ДВИЖЕНИЕ ФИШКИ
// ═══════════════════════════════════════════
function _stepAnim(el) {
  if (!el) return;
  el.classList.remove('moving');
  void el.offsetHeight; // перезапускаем анимацию
  el.classList.add('moving');
}
function _landFx(el) {
  if (!el) return;
  el.classList.add('landing');
  setTimeout(() => el.classList.remove('landing'), 500);
}

// Шаг за шагом по клеткам питстопа-срезки. Очки заморожены (стоим на кл.14),
// начисляются разом при выходе на кл.19. Возвращает остаток шагов после выхода.
async function walkPit(player, steps, el) {
  for (let i = 0; i < steps; i++) {
    if (player.pit >= PIT_CELLS.length) {
      // Прошли все клетки срезки → выходим на основную дорогу (кл.19), очки начисляются.
      player.pit = null;
      player.score = PIT_EXIT;
      SFX.move(); _stepAnim(el);
      positionToken(player); renderScoreboard();
      await sleep(MOVE_DELAY);
      if (el) el.classList.remove('moving');
      showToast(t('pitDone', PIT_EXIT - PIT_ENTRY));
      return steps - i - 1;   // остаток шагов идёт уже по основной дороге
    }
    player.pit += 1;          // встаём на следующую клетку срезки (1..10)
    SFX.move(); _stepAnim(el);
    positionToken(player); renderScoreboard();
    await sleep(MOVE_DELAY);
    if (el) el.classList.remove('moving');
  }
  return 0;   // шаги кончились, всё ещё внутри питстопа
}

async function moveToken(player, steps, direction, applySpecial = true) {
  const el = document.getElementById(`token-${player.id}`);
  let remaining = steps;

  // Движение назад (напр. карта Судьи) сбрасывает заход в питстоп — фишка на основной дороге.
  if (direction < 0 && player.pit != null) { player.pit = null; positionToken(player); }

  // Если игрок зашёл на вход питстопа (стоит на кл.14) и идёт вперёд — шагаем по срезке.
  if (direction > 0 && player.pit != null) {
    remaining = await walkPit(player, remaining, el);
    if (remaining <= 0) { _landFx(el); return; }
    // вышли из питстопа на кл.19 — остаток шагов продолжаем по основной дороге
  }

  for (let i = 0; i < remaining; i++) {
    const newScore = player.score + direction;
    if (newScore < 0) break;
    player.score = newScore;
    SFX.move();
    _stepAnim(el);
    positionToken(player);
    renderScoreboard();
    await sleep(MOVE_DELAY);
    if (el) el.classList.remove('moving');

    // Зашли РОВНО на вход питстопа последним шагом — со следующего хода идём по срезке.
    if (direction > 0 && player.pit == null && player.score === PIT_ENTRY && i === remaining - 1) {
      player.pit = 0;
      showToast(t('pitToast'));
    }
  }
  _landFx(el);
  // Спецклетки-стрелки (нарисованы на field.png), только при движении вперёд.
  // Внутри/на входе питстопа стрелки не срабатывают.
  if (applySpecial && direction > 0 && player.pit == null && player.score < WIN_SCORE) {
    const pos = boardPos(player);
    {
      // Стрелка: SPECIAL по НОМЕРУ клетки (pos+1), to — тоже номер → индекс = to-1.
      const sp = SPECIAL[pos + 1];
      const toIdx = sp ? sp.to - 1 : -1;
      if (sp && toIdx !== player.score) {
        await sleep(380);
        SFX.card();
        showToast(toIdx > pos ? t('fwdToast') : t('backToast'));
        player.score = Math.max(0, Math.min(toIdx, WIN_SCORE));
        if (el) {
          el.classList.remove('moving'); void el.offsetHeight; el.classList.add('moving');
          el.classList.add('landing');
          setTimeout(() => { el.classList.remove('moving'); el.classList.remove('landing'); }, 600);
        }
        positionToken(player);
        renderScoreboard();
        await sleep(MOVE_DELAY + 200);
      }
    }
  }
}

// Поставить фишку по произвольным процентным координатам (для проезда питстопа).
function positionTokenAt(player, lPct, tPct) {
  const el = document.getElementById(`token-${player.id}`);
  if (!el) return;
  syncLayers();
  el.style.left = lPct + '%';   // процент от tokens-layer (= видимая картинка)
  el.style.top  = tPct + '%';
}

// Реальный прямоугольник ВИДИМОЙ картинки внутри #field-img (object-fit:contain).
// getBoundingClientRect даёт размер ЭЛЕМЕНТА (с возможными полями-letterbox),
// а нам нужна область самой картинки — иначе клетки/фишки съезжают.
function imageContentRect(img) {
  const r = img.getBoundingClientRect();
  const nW = img.naturalWidth, nH = img.naturalHeight;
  if (!nW || !nH) return r;
  const elemRatio = r.width / r.height, imgRatio = nW / nH;
  let cw, ch, ox = 0, oy = 0;
  if (imgRatio > elemRatio) { cw = r.width; ch = r.width / imgRatio; oy = (r.height - ch) / 2; }
  else { ch = r.height; cw = r.height * imgRatio; ox = (r.width - cw) / 2; }
  return { left: r.left + ox, top: r.top + oy, width: cw, height: ch };
}

// Ставим слои клеток/фишек/стрелок ТОЧНО поверх видимой картинки.
// После этого позиции внутри слоёв задаются простыми процентами — letterbox не влияет.
function syncLayers() {
  const img = document.getElementById('field-img');
  const wrap = document.getElementById('field-wrap');
  if (!img || !wrap) return;
  const ir = imageContentRect(img);
  const wr = wrap.getBoundingClientRect();
  if (!ir.width) return;
  const L = ir.left - wr.left, T = ir.top - wr.top;
  ['cells-layer', 'tokens-layer', 'arrows-layer'].forEach(id => {
    const el = document.getElementById(id);
    if (!el) return;
    el.style.left = L + 'px'; el.style.top = T + 'px';
    el.style.width = ir.width + 'px'; el.style.height = ir.height + 'px';
  });
}

function positionToken(player, instant = false) {
  const el = document.getElementById(`token-${player.id}`);
  if (!el) return;

  const img = document.getElementById('field-img');
  const ir  = imageContentRect(img);
  syncLayers();

  // Питстоп: фишка стоит на клетке срезки (pit=1..10 → PIT_CELLS[pit-1]).
  // pit=0 — стоим ещё на входе (кл.14), обрабатывается обычной веткой ниже.
  if (player.pit != null && player.pit >= 1) {
    const [pl, pt] = PIT_CELLS[player.pit - 1];
    const nxt = PIT_CELLS[player.pit] || ROUTE[PIT_EXIT];
    const ang = Math.atan2((nxt[1] - pt) * ir.height, (nxt[0] - pl) * ir.width) * 180 / Math.PI + 90;
    if (instant) el.classList.add('no-anim');
    el.style.left = pl + '%';
    el.style.top  = pt + '%';
    el.style.setProperty('--ta', ang + 'deg');
    if (instant) { void el.offsetHeight; el.classList.remove('no-anim'); }
    return;
  }

  const pos = boardPos(player);
  const [lPct, tPct] = ROUTE[pos];

  // Раскладка фишек на одной клетке: 1 — по центру, 2+ — симметрично, без налезания.
  // Фишки внутри питстопа не участвуют в раскладке основной дороги.
  const onCell = players.filter(p => p.pit == null && boardPos(p) === pos);
  const total  = onCell.length;
  const myIdx  = onCell.findIndex(p => p.id === player.id);
  const d = 13;   // px — половина шага между фишками (фишка 24px)
  let off = [0, 0];
  if (total === 2)      off = [[-d, 0], [d, 0]][myIdx];
  else if (total === 3) off = [[0, -d], [-d, d], [d, d]][myIdx];
  else if (total >= 4)  off = [[-d, -d], [d, -d], [-d, d], [d, d]][myIdx] || [0, 0];

  // Угол поворота — вдоль трассы к следующей клетке (круг замкнут, после 49 → 0)
  const b = (pos + 1) % ROUTE.length;
  const dx = (ROUTE[b][0] - lPct) * ir.width;
  const dy = (ROUTE[b][1] - tPct) * ir.height;
  const angle = Math.atan2(dy, dx) * 180 / Math.PI + 90;

  if (instant) el.classList.add('no-anim');
  // Позиция в процентах от tokens-layer (= видимая картинка) + px-сдвиг для совмещённых фишек
  el.style.left = `calc(${lPct}% + ${off[0]}px)`;
  el.style.top  = `calc(${tPct}% + ${off[1]}px)`;
  el.style.setProperty('--ta', angle + 'deg');
  if (instant) { void el.offsetHeight; el.classList.remove('no-anim'); }
}

// ═══════════════════════════════════════════
// ПОБЕДА
// ═══════════════════════════════════════════
function checkWin() {
  const winner = players.find(p => p.score >= WIN_SCORE);
  if (!winner) return false;
  gameOver = true;
  stopTimer();
  clearSave();
  if (online.active && isMyTurn()) netSend({ t: 'win', scores: players.map(p => p.score) });
  setTimeout(() => SFX.win(), 700);
  const nameEl = document.getElementById('win-winner-name');
  nameEl.textContent = winner.name;
  nameEl.style.color = winner.color;
  document.getElementById('win-winner-label').textContent = t('wonRace');
  const sorted = [...players].sort((a, b) => b.score - a.score);
  document.getElementById('win-stats').innerHTML = sorted.map((p, i) =>
    `<div class="win-stat-chip" style="border:2px solid ${p.color}44;color:${p.color}">${['🥇','🥈','🥉','4️⃣'][i]} ${p.name}: ${p.score}</div>`
  ).join('');
  spawnConfetti();
  setTimeout(() => showScreen('screen-win'), 800);
  return true;
}

function spawnConfetti() {
  const container = document.getElementById('confetti-container');
  container.innerHTML = '';
  const colors = ['#f0c040','#ff5252','#4caf50','#4a9eff','#ff9900','#cc44ff','#fff'];
  for (let i = 0; i < 60; i++) {
    const p = document.createElement('div');
    p.className = 'confetti-piece';
    p.style.cssText = `
      left:${Math.random()*100}%;top:-10px;
      background:${colors[Math.floor(Math.random()*colors.length)]};
      width:${6+Math.random()*8}px;height:${6+Math.random()*8}px;
      border-radius:${Math.random()>0.5?'50%':'2px'};
      animation-duration:${1.5+Math.random()*2}s;
      animation-delay:${Math.random()*0.8}s;
    `;
    container.appendChild(p);
  }
}

// ═══════════════════════════════════════════
// РЕЗУЛЬТАТ И ПРОДОЛЖЕНИЕ
// ═══════════════════════════════════════════
let resultHandled = false;
let resultOnContinue = null;
function showResult(success, title, sub, onContinue = null) {
  resultHandled = false;
  resultOnContinue = onContinue;
  if (online.active && online.started && isMyTurn()) netSend({ t: 'result', success, title, sub });
  if (success) SFX.success(); else SFX.fail();
  const emoji = document.getElementById('result-emoji');
  emoji.textContent = success ? '✅' : '❌';
  emoji.style.animation = 'none'; void emoji.offsetHeight; emoji.style.animation = '';
  document.getElementById('result-text').textContent = title;
  document.getElementById('result-sub').textContent  = sub;
  const btn = document.getElementById('btn-continue');
  btn.style.display = 'none';
  btn.textContent = t('contArrow', 0);
  showScreen('screen-result');
  const isBot = currentPlayer().isBot;
  setTimeout(() => {
    btn.style.animation = 'none'; void btn.offsetHeight; btn.style.animation = '';
    btn.style.display = 'block';
    if (!isBot) {
      let cd = 4;
      btn.textContent = t('contArrow', cd);
      btn._cd = setInterval(() => {
        cd--;
        if (cd > 0) { btn.textContent = t('contArrow', cd); }
        else { clearInterval(btn._cd); btn._cd = null; btn.textContent = t('contArrow', 0); triggerContinue(); }
      }, 1000);
    }
  }, 300);
}

function triggerContinue() {
  if (resultHandled) return;
  resultHandled = true;
  const btn = document.getElementById('btn-continue');
  if (btn._cd) { clearInterval(btn._cd); btn._cd = null; btn.textContent = t('contArrow', 0); }
  if (resultOnContinue) { resultOnContinue(); resultOnContinue = null; }
}

function afterMove() {
  currentPlayerIdx = (currentPlayerIdx + 1) % players.length;
  updateTurnLabel();
  renderScoreboard();
  renderSpecialCards();
  document.getElementById('btn-play-turn').disabled = false;
  showScreen('screen-game');
  setTimeout(() => players.forEach(p => positionToken(p, true)), 60);
  saveGame();
  if (online.active && online.started) {
    netSend({ t: 'sync', scores: players.map(p => p.score), cur: currentPlayerIdx, hands: serializeHands() });
    updateOnlineTurnUI();
  }
}

// ═══════════════════════════════════════════
// БОТ
// ═══════════════════════════════════════════
function botFindWords(card, needed, sampleSize = 600) {
  const letters = card.split('');
  const found = [];
  const sample = dictionary.slice().sort(() => Math.random() - 0.5).slice(0, sampleSize);
  for (const word of sample) {
    if (found.length >= needed + 3) break;
    if (word === card || word.length < 2 || found.includes(word)) continue;
    const avail = [...letters];
    let ok = true;
    for (const ch of word) {
      const idx = avail.indexOf(ch);
      if (idx === -1) { ok = false; break; }
      avail.splice(idx, 1);
    }
    if (ok) found.push(word);
  }
  return found;
}

async function botPlayTurn() {
  const player = currentPlayer();

  // Auto-use racer card
  const racerIdx = player.specialCards.findIndex(c => c.type === 'racer');
  if (racerIdx >= 0) {
    player.specialCards.splice(racerIdx, 1);
    renderSpecialCards();
    showResult(true, t('racerGo', player.name), t('fwd', wordsNeeded));
    await sleep(1800);
    showScreen('screen-game');
    await sleep(80);
    await moveToken(player, wordsNeeded, 1);
    spawnScoreFloat(player.id, `+${wordsNeeded}`, player.color);
    if (checkWin()) return;
    afterMove();
    return;
  }

  // Auto-use judge card — только если есть у кого отбирать очки
  const judgeIdx = player.specialCards.findIndex(c => c.type === 'judge');
  const victims = players.filter(p => p.id !== player.id && p.score > 0);
  if (judgeIdx >= 0 && victims.length > 0) {
    player.specialCards.splice(judgeIdx, 1);
    renderSpecialCards();
    const victim = victims.reduce((a, b) => a.score > b.score ? a : b);
    applyJudge(victim);
    return;
  }

  await botDoTask(player);
}

async function botDoTask(player) {
  const label = document.getElementById('bot-thinking-label');
  label.textContent = t('botThinking', player.name);
  label.style.color = player.color;
  document.getElementById('overlay-bot').classList.add('show');
  await sleep(900 + Math.random() * 900);
  document.getElementById('overlay-bot').classList.remove('show');

  // Сила бота = явная вероятность успеха хода (😊 0.40 / 😐 0.65 / 🔥 0.90)
  const rate = BOT_RATE[player.botDifficulty] ?? 0.65;
  const success = Math.random() < rate;
  if (success) {
    showResult(true, t('botDid', player.name), t('fwd', wordsNeeded));
    await sleep(1800);
    showScreen('screen-game');
    await sleep(80);
    await moveToken(player, wordsNeeded, 1);
    spawnScoreFloat(player.id, `+${wordsNeeded}`, player.color);
    checkWin();
  } else {
    showResult(false, t('botFail', player.name), t('backN', wordsNeeded));
    await sleep(1800);
    showScreen('screen-game');
    await sleep(80);
    await moveToken(player, wordsNeeded, -1);
    spawnScoreFloat(player.id, `-${wordsNeeded}`, '#ff5252');
    renderScoreboard();
  }
  if (gameOver) return;
  afterMove();
}

// ═══════════════════════════════════════════
// РЕНДЕР
// ═══════════════════════════════════════════
// Номера клеток 1..50 поверх поля (старт/финиш/питстоп/стрелки подсвечены).
// Номер в центре клетки — на той же позиции, где стоит фишка.
function renderCells() {
  const layer = document.getElementById('cells-layer');
  if (!layer) return;
  syncLayers();
  layer.innerHTML = '';
  ROUTE.forEach((pt, i) => {
    const num = i + 1;
    // На поле оставляем только метки-вёрсты: 10, 20, 30, 40, 50.
    // Старт/финиш/стрелки уже нарисованы на самой картинке поля.
    if (num % 10 !== 0) return;
    const d = document.createElement('div');
    d.className = 'cell-num';
    d.style.left = pt[0] + '%';   // процент от слоя (= видимая картинка)
    d.style.top  = pt[1] + '%';
    d.textContent = num;
    layer.appendChild(d);
  });
}

function renderTokens() {
  const layer = document.getElementById('tokens-layer');
  layer.innerHTML = '';
  players.forEach(p => {
    const img = document.createElement('img');
    img.id = `token-${p.id}`;
    img.className = 'token';
    img.src = p.img; img.alt = p.name;
    layer.appendChild(img);
    positionToken(p, true);
  });
}

function renderScoreboard() {
  const sb = document.getElementById('scoreboard');
  sb.innerHTML = '';
  players.forEach((p, i) => {
    const chip = document.createElement('div');
    chip.className = 'score-chip' + (i === currentPlayerIdx ? ' active-turn' : '');
    const cards = (p.specialCards && p.specialCards.length)
      ? ` <span class="chip-cards">${p.specialCards.map(c => c.icon).join('')}</span>` : '';
    chip.innerHTML = `<span class="dot" style="background:${p.color}"></span>${p.isBot ? '🤖' : ''}${p.name}: ${boardPos(p)}/50${cards}`;
    sb.appendChild(chip);
  });
}

function updateTurnLabel() {
  const p = currentPlayer();
  document.getElementById('turn-label').innerHTML = `${t('turn')}: <span style="color:${p.color}">${p.name}</span>`;
}

function renderSpecialCards() {
  const ui = document.getElementById('special-cards-ui');
  const player = online.active ? players[online.myIdx] : currentPlayer();
  if (!player) { ui.innerHTML = ''; return; }
  ui.innerHTML = '';
  // Карты в руке — только показ (что есть у игрока). Кликать по ним нельзя:
  // разыгрываются автоматически при «Начать ход».
  player.specialCards.forEach(card => {
    const chip = document.createElement('div');
    chip.className = 'hand-card ' + card.type;
    chip.textContent = cardLabel(card.type);
    chip.title = t('cardInHand');
    ui.appendChild(chip);
  });
}

// ═══════════════════════════════════════════
// DEBUG — тестирование спецкарт
// ═══════════════════════════════════════════
function toggleDebugPanel() {
  document.getElementById('debug-panel').classList.toggle('hidden');
}
function debugGiveCard(type) {
  const p = currentPlayer();
  if (!p) { showToast('Сначала начни партию'); return; }
  p.specialCards.push({ ...SPECIAL_DEF[type] });
  renderSpecialCards();
  showToast(`+ ${cardLabel(type)}`);
}
async function debugMove(n) {
  const p = currentPlayer();
  if (!p) { showToast('Сначала начни партию'); return; }
  await moveToken(p, n, 1);
  if (checkWin()) return;
  renderScoreboard();
}
async function debugTeleport() {
  const p = currentPlayer();
  if (!p) { showToast('Сначала начни партию'); return; }
  const v = parseInt(document.getElementById('debug-cell').value, 10);  // номер клетки 1..50
  if (isNaN(v) || v < 1 || v > WIN_SCORE + 1) { showToast('Клетка 1–' + (WIN_SCORE + 1)); return; }
  // Ставим на клетку ПЕРЕД указанной и шагаем 1 вперёд — чтобы сработали
  // спецклетки/питстоп (они активны только при движении на клетку).
  p.score = v - 2 < 0 ? 0 : v - 2;
  positionToken(p, true);
  renderScoreboard();
  await moveToken(p, v - 1 - p.score, 1);
  if (checkWin()) return;
  renderScoreboard();
}

// ═══════════════════════════════════════════
// КАЛИБРОВКА МАРШРУТА (интерактивная)
// 5 тапов по полю → режим расстановки точек
// Тап по треку → точка 0, 1, 2... по порядку
// Кнопка "Готово" → применяет новый ROUTE
// ═══════════════════════════════════════════
let calibTapCount = 0;
let calibTapTimer = null;
let calibActive   = false;
let calibPoints   = [];  // [[l%, t%], ...]

function handleFieldTap(event) {
  if (!DEBUG_ENABLED) return;   // в релизе калибровка отключена
  if (editorActive) { editorClick(event); return; }
  if (calibActive) {
    placeCalibPoint(event);
    return;
  }
  calibTapCount++;
  clearTimeout(calibTapTimer);
  calibTapTimer = setTimeout(() => { calibTapCount = 0; }, 700);
  if (calibTapCount >= 5) {
    calibTapCount = 0;
    startCalib();
  }
}

function startCalib() {
  calibActive = true;
  calibPoints = [];
  document.getElementById('debug-overlay').classList.add('show');
  document.getElementById('calib-bar').classList.add('show');
  renderCalibDots();
  updateCalibBar();
  showToast('📍 Жми по треку — расставь ' + ROUTE.length + ' точек', 3000);
}

function stopCalib() {
  calibActive = false;
  document.getElementById('debug-overlay').classList.remove('show');
  document.getElementById('debug-overlay').innerHTML = '';
  document.getElementById('calib-bar').classList.remove('show');
}

const CALIB_MAX = 60;   // максимум клеток при калибровке
function placeCalibPoint(event) {
  if (calibPoints.length >= CALIB_MAX) return;
  const img = document.getElementById('field-img');
  const ir  = imageContentRect(img);
  const x   = event.clientX - ir.left;
  const y   = event.clientY - ir.top;
  if (x < 0 || x > ir.width || y < 0 || y > ir.height) return;
  const lPct = Math.round(x / ir.width  * 1000) / 10;
  const tPct = Math.round(y / ir.height * 1000) / 10;
  calibPoints.push([lPct, tPct]);
  renderCalibDots();
  updateCalibBar();
}

function renderCalibDots() {
  const overlay = document.getElementById('debug-overlay');
  const img  = document.getElementById('field-img');
  const wrap = document.getElementById('field-wrap');
  const ir   = imageContentRect(img);
  const wr   = wrap.getBoundingClientRect();
  overlay.innerHTML = '';

  // Уже расставленные — зелёные
  calibPoints.forEach(([lPct, tPct], i) => {
    const dot = document.createElement('div');
    dot.className = 'debug-dot placed';
    dot.textContent = i;
    dot.style.left = ((ir.left - wr.left) + (lPct / 100) * ir.width)  + 'px';
    dot.style.top  = ((ir.top  - wr.top)  + (tPct / 100) * ir.height) + 'px';
    overlay.appendChild(dot);
  });

  // Следующая точка — пунктирный кружок-подсказка (центр поля)
  if (calibPoints.length < CALIB_MAX) {
    const ghost = document.createElement('div');
    ghost.className = 'debug-dot next-dot';
    ghost.textContent = calibPoints.length;
    ghost.style.left = ((ir.left - wr.left) + 0.5 * ir.width)  + 'px';
    ghost.style.top  = ((ir.top  - wr.top)  + 0.5 * ir.height) + 'px';
    overlay.appendChild(ghost);
  }
}

function updateCalibBar() {
  const n = calibPoints.length;
  document.getElementById('calib-count').textContent = `Клеток: ${n}`;
  const done = document.getElementById('calib-done');
  done.className = 'calib-btn' + (n >= 2 ? ' ready' : '');
  done.textContent = n >= 2 ? `✓ Применить (${n})` : '✓ Готово';
}

function calibUndo(e) {
  e.stopPropagation();
  if (calibPoints.length === 0) return;
  calibPoints.pop();
  renderCalibDots();
  updateCalibBar();
}

function calibReset(e) {
  e.stopPropagation();
  calibPoints = [];
  renderCalibDots();
  updateCalibBar();
}

function calibDone(e) {
  e.stopPropagation();
  if (calibPoints.length === 0) { stopCalib(); return; }

  // Берём ровно расставленные точки (любое число) — новый ROUTE
  const newRoute = calibPoints.slice();

  // Применяем в памяти
  ROUTE.splice(0, ROUTE.length, ...newRoute);
  if (players.length > 0) players.forEach(p => positionToken(p, true));

  stopCalib();

  // Генерируем текст для вставки в файл
  const rows = [];
  for (let i = 0; i < newRoute.length; i += 6) {
    rows.push('  ' + newRoute.slice(i, i + 6).map(([l, t]) => `[${l},${t}]`).join(','));
  }
  const routeStr = 'const ROUTE = [\n' + rows.join(',\n') + '\n];';
  document.getElementById('calib-route-text').value = routeStr;
  document.getElementById('overlay-calib-copy').style.display = 'flex';
}

function selectCalibText() {
  const ta = document.getElementById('calib-route-text');
  ta.focus(); ta.select();
  try { document.execCommand('copy'); showToast('📋 Скопировано!'); } catch(e) {}
}

// ═══════════════════════════════════════════
// РЕДАКТОР ПОЛЯ — стрелки и путь питстопа (debug)
// ═══════════════════════════════════════════
let editorActive = false;
let editorMode   = null;       // 'arrows' | 'pit'
let editorArrows = [];         // [[fromIdx, toIdx], ...]
let editorPit    = [];         // [[l%, t%], ...] точки траектории питстопа
let editorPickFrom = null;     // выбранная клетка-источник стрелки

function startEditor(mode) {
  if (!players.length) { showToast('Сначала начни партию'); return; }
  editorActive = true;
  editorMode = mode;
  editorPickFrom = null;
  // Инициализируем из текущих данных, чтобы можно было дополнять
  if (mode === 'arrows' && editorArrows.length === 0) {
    editorArrows = Object.entries(SPECIAL).map(([k, v]) => [parseInt(k, 10), v.to]);
  }
  if (mode === 'pit' && editorPit.length === 0) {
    editorPit = PIT_ROUTE.map(p => p.slice());
  }
  document.getElementById('debug-panel').classList.add('hidden');
  document.getElementById('editor-bar').classList.add('show');
  updateEditorBar();
  renderEditor();
  showToast(mode === 'arrows'
    ? '➡️ Клик на клетку-ИСТОЧНИК, потом на ЦЕЛЬ'
    : '🔧 Клик по точкам пути питстопа (по порядку)', 3200);
}

function stopEditor() {
  editorActive = false;
  document.getElementById('editor-bar').classList.remove('show');
  document.getElementById('arrows-layer').innerHTML = '';
  document.getElementById('debug-overlay').innerHTML = '';
}

// Индекс ближайшей клетки ROUTE к точке клика
function nearestCell(lPct, tPct) {
  let best = 0, bd = 1e9;
  ROUTE.forEach((pt, i) => {
    const d = Math.hypot(pt[0] - lPct, pt[1] - tPct);
    if (d < bd) { bd = d; best = i; }
  });
  return best;
}

function editorClick(event) {
  const img = document.getElementById('field-img');
  const ir = imageContentRect(img);
  const lPct = (event.clientX - ir.left) / ir.width  * 100;
  const tPct = (event.clientY - ir.top)  / ir.height * 100;
  if (lPct < 0 || lPct > 100 || tPct < 0 || tPct > 100) return;

  if (editorMode === 'arrows') {
    const idx = nearestCell(lPct, tPct);
    if (editorPickFrom === null) {
      editorPickFrom = idx;
    } else {
      if (idx !== editorPickFrom) editorArrows.push([editorPickFrom, idx]);
      editorPickFrom = null;
    }
  } else { // pit — добавляем точку траектории
    editorPit.push([Math.round(lPct * 10) / 10, Math.round(tPct * 10) / 10]);
  }
  updateEditorBar();
  renderEditor();
}

function updateEditorBar() {
  const c = document.getElementById('editor-count');
  if (editorMode === 'arrows') {
    c.textContent = `Стрелок: ${editorArrows.length}` + (editorPickFrom !== null ? ` (из ${editorPickFrom + 1} → ?)` : '');
  } else {
    c.textContent = `Точек питстопа: ${editorPit.length}`;
  }
}

function renderEditor() {
  const svg = document.getElementById('arrows-layer');
  const ov  = document.getElementById('debug-overlay');
  const img = document.getElementById('field-img');
  const wrap = document.getElementById('field-wrap');
  const ir = imageContentRect(img);
  const wr = wrap.getBoundingClientRect();
  if (!ir.width) return;
  const X = p => (ir.left - wr.left) + (p / 100) * ir.width;
  const Y = p => (ir.top  - wr.top)  + (p / 100) * ir.height;
  svg.innerHTML = ''; ov.innerHTML = '';

  // defs со стрелкой
  svg.insertAdjacentHTML('beforeend',
    '<defs><marker id="ah" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto">' +
    '<path d="M0,0 L6,3 L0,6 Z" fill="#ffd24a"/></marker></defs>');

  // Стрелки источник→цель
  editorArrows.forEach(([f, to]) => {
    const x1 = X(ROUTE[f][0]), y1 = Y(ROUTE[f][1]);
    const x2 = X(ROUTE[to][0]), y2 = Y(ROUTE[to][1]);
    svg.insertAdjacentHTML('beforeend',
      `<line x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}" stroke="#ffd24a" stroke-width="3" marker-end="url(#ah)" opacity="0.9"/>`);
  });

  // Путь питстопа — линия + точки
  if (editorPit.length) {
    const pts = editorPit.map(([l, t]) => `${X(l)},${Y(t)}`).join(' ');
    svg.insertAdjacentHTML('beforeend',
      `<polyline points="${pts}" fill="none" stroke="#8fe2f5" stroke-width="3" stroke-dasharray="6 4"/>`);
    editorPit.forEach(([l, t], i) => {
      const dot = document.createElement('div');
      dot.className = 'debug-dot placed';
      dot.textContent = i + 1;
      dot.style.left = X(l) + 'px'; dot.style.top = Y(t) + 'px';
      ov.appendChild(dot);
    });
  }

  // Подсветка выбранного источника
  document.querySelectorAll('.cell-num.editor-pick').forEach(e => e.classList.remove('editor-pick'));
  if (editorPickFrom !== null) {
    const nums = document.querySelectorAll('#cells-layer .cell-num');
    if (nums[editorPickFrom]) nums[editorPickFrom].classList.add('editor-pick');
  }
}

function editorUndo(e) {
  e.stopPropagation();
  if (editorMode === 'arrows') { editorPickFrom = null; editorArrows.pop(); }
  else editorPit.pop();
  updateEditorBar(); renderEditor();
}

function editorReset(e) {
  e.stopPropagation();
  if (editorMode === 'arrows') { editorArrows = []; editorPickFrom = null; }
  else editorPit = [];
  updateEditorBar(); renderEditor();
}

function editorDone(e) {
  e.stopPropagation();
  let txt = '';
  if (editorMode === 'arrows') {
    const lines = editorArrows.map(([f, to]) => `  ${f}: { type: 'fwd', to: ${to} },`);
    txt = 'const SPECIAL = {\n' + lines.join('\n') + '\n};';
  } else {
    const rows = [];
    for (let i = 0; i < editorPit.length; i += 6) {
      rows.push('  ' + editorPit.slice(i, i + 6).map(([l, t]) => `[${l},${t}]`).join(','));
    }
    txt = 'const PIT_ROUTE = [\n' + rows.join(',\n') + '\n];';
  }
  stopEditor();
  document.getElementById('calib-route-text').value = txt;
  document.getElementById('overlay-calib-copy').style.display = 'flex';
}

// ═══════════════════════════════════════════
// УТИЛИТЫ
// ═══════════════════════════════════════════
function currentPlayer() { return players[currentPlayerIdx]; }

// ═══════════════════════════════════════════
// СОХРАНЕНИЕ / ПРОДОЛЖЕНИЕ (локальная партия)
// ═══════════════════════════════════════════
const SAVE_KEY = 'vr_savegame';

function saveGame() {
  if (online.active || gameOver || players.length < 2) return;
  try {
    const data = {
      players: players.map(p => ({
        id: p.id, score: p.score, pit: (p.pit ?? null), isBot: !!p.isBot,
        botDifficulty: p.botDifficulty || 'normal',
        cards: (p.specialCards || []).map(c => c.type)
      })),
      cur: currentPlayerIdx, ts: Date.now()
    };
    localStorage.setItem(SAVE_KEY, JSON.stringify(data));
  } catch (e) {}
}

function loadSave() { try { return JSON.parse(localStorage.getItem(SAVE_KEY)); } catch (e) { return null; } }
function clearSave() { try { localStorage.removeItem(SAVE_KEY); } catch (e) {} }
function hasSave() { const s = loadSave(); return !!(s && s.players && s.players.length >= 2); }

function updateContinueButton() {
  const btn = document.getElementById('menu-continue-btn');
  if (btn) btn.style.display = hasSave() ? 'block' : 'none';
}

function continueGame() {
  const s = loadSave();
  if (!s) { showToast(t('noSave')); updateContinueButton(); return; }
  online.active = false;
  players = s.players.map(sp => ({
    ...PLAYERS_CONFIG[sp.id], name: colorName(sp.id),
    score: sp.score, pit: (sp.pit ?? null), isBot: sp.isBot, botDifficulty: sp.botDifficulty,
    specialCards: (sp.cards || []).map(tp => ({ ...SPECIAL_DEF[tp] })).filter(c => c.type)
  }));
  gameOver = false;
  currentPlayerIdx = Math.min(s.cur || 0, players.length - 1);
  turnsUntilSpecial = rollSpecialGap();
  buildDeck();
  renderScoreboard(); updateTurnLabel(); renderSpecialCards();
  document.getElementById('btn-play-turn').disabled = false;
  showScreen('screen-game');  // showScreen сам вызовет drawBoard
}

function showScreen(id) {
  if (id === 'screen-setup') renderSetup();
  if (id === 'screen-menu') updateContinueButton();
  const prev = document.querySelector('.screen.active');
  if (prev && prev.id !== id) {
    prev.classList.add('leaving');
    prev.classList.remove('active');
    setTimeout(() => prev.classList.remove('leaving'), 220);
  }
  const next = document.getElementById(id);
  next.classList.add('active');
  activeScreen = id;

  // Экран игры стал видимым — перерисовать поле (ждёт готовности размеров внутри).
  if (id === 'screen-game' && players.length) {
    drawBoard();
    // Появление идёт с анимацией fadeIn (scale 0.97→1): при синхронном вызове выше
    // картинка ещё уменьшена, и слои считаются по искажённому размеру. Пересчитываем
    // после завершения анимации — иначе поле «обновляется только после первого хода».
    next.addEventListener('animationend', function onAnim(e) {
      if (e.animationName !== 'fadeIn') return;
      next.removeEventListener('animationend', onAnim);
      drawBoard();
    });
    // Подстраховка на случай, если animationend не сработает.
    setTimeout(() => { if (activeScreen === 'screen-game') drawBoard(); }, 300);
  }
}

function showToast(msg, duration = 2200) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  clearTimeout(t._timer);
  t.className = '';
  void t.offsetHeight;
  t.className = 'show';
  t._timer = setTimeout(() => { t.className = 'hide'; }, duration);
}

function spawnScoreFloat(playerId, text, color) {
  const el = document.getElementById(`token-${playerId}`);
  if (!el) return;
  const layer = document.getElementById('tokens-layer');
  const f = document.createElement('div');
  f.className = 'score-float';
  f.style.color = color;
  f.style.left = el.style.left;
  f.style.top  = el.style.top;
  f.textContent = text;
  layer.appendChild(f);
  setTimeout(() => f.remove(), 1000);
}

function sleep(ms) { return new Promise(r => setTimeout(r, ms)); }

window.addEventListener('resize', () => {
  syncLayers();
  if (players.length > 0) players.forEach(p => positionToken(p, true));
  renderCells();
  if (calibActive) renderCalibDots();
  if (editorActive) renderEditor();
});

// ResizeObserver на поле: надёжно ловит момент, когда #field-wrap получает размер
// (при показе экрана игры он переходит из скрытого 0 в реальный) — и сразу рисует.
(function () {
  const fw  = document.getElementById('field-wrap');
  const img = document.getElementById('field-img');
  // Перерисовка при готовности картинки (в т.ч. если она уже в кэше).
  if (img) {
    const onReady = () => { if (activeScreen === 'screen-game') drawBoard(); };
    if (img.complete && img.naturalWidth) onReady();
    img.addEventListener('load', onReady);
  }
  if (!fw || !window.ResizeObserver) return;
  let lastW = 0;
  new ResizeObserver(() => {
    const r = fw.getBoundingClientRect();
    if (r.width === 0 || r.width === lastW) return;
    lastW = r.width;
    syncLayers();
    if (activeScreen === 'screen-game') {
      renderCells();
      if (players.length) players.forEach(p => positionToken(p, true));
    }
  }).observe(fw);
})();

init();
</script>
</body>
</html>
